      "id": "845b8a55-760e-4b2d-b792-bbed6bf5e0e7",
      "name": "Combine KB Content",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        672,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const CHAR_BUDGET = 12000; // ~3000 tokens, safely under the 12k TPM limit\nconst first = $input.first().json;\nconst raw = first.content;\nconst docs = (Array.isArray(raw) ? raw : [raw])\n  .map(d => String(d == null ? '' : d))\n  .filter(d => d.trim().length > 0);\n\nconst trigger = $('Chat Trigger').first().json;\nconst question = String(trigger.chatInput || '');\nconst sessionId = String(trigger.sessionId || '');\nconst stop = new Set(['the','a','an','is','are','can','i','you','to','of','and','or','in','on','for','my','me','do','does','with','what','how','when','where','why','get','we','our','your']);\nconst qWords = question\n  .toLowerCase()\n  .split(/[^a-z0-9]+/)\n  .filter(w => w.length > 2 && !stop.has(w));\n\nconst scored = docs.map(text => {\n  const lower = text.toLowerCase();\n  let score = 0;\n  for (const w of qWords) {\n    let idx = lower.indexOf(w);\n    while (idx !== -1) { score++; idx = lower.indexOf(w, idx + w.length); }\n  }\n  return { text, score };\n});\nscored.sort((a, b) => b.score - a.score);\n\nlet context = '';\nfor (const d of scored) {\n  // once we have some relevant context, skip zero-match docs\n  if (d.score === 0 && context.length > 0) continue;\n  const sep = context ? '\\n\\n---\\n\\n' : '';\n  const remaining = CHAR_BUDGET - context.length - sep.length;\n  if (remaining <= 0) break;\n  context += sep + (d.text.length > remaining ? d.text.slice(0, remaining) : d.text);\n  if (context.length >= CHAR_BUDGET) break;\n}\n\nif (!context && scored.length) {\n  context = scored[0].text.slice(0, CHAR_BUDGET);\n}\n\nreturn [{ json: { context, chatInput: question, sessionId } }];"
      },
